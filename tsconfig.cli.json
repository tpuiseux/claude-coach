{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true
  },
  "include": [
    "src/cli.ts",
    "src/db/**/*",
    "src/auth/**/*",
    "src/schema/**/*",
    "src/strava/**/*",
    "src/lib/config.ts",
    "src/lib/logging.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
